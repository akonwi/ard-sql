use go:database/sql
use go:github.com/akonwi/ard-sql/ffi
use go:regexp
use go:strings

// A wrapper over Go's database/sql, replacing the removed `ard/sql` stdlib module. Backed by pure-Go drivers so the compiled binary needs no
// CGO:
//
//   - "pgx"    (github.com/jackc/pgx/v5/stdlib)  for Postgres
//   - "sqlite" (modernc.org/sqlite)              for SQLite
//   - "mysql"  (github.com/go-sql-driver/mysql)  for MySQL
//
// Database.query("...").all(["name": val]) etc. Rows come back as
// [Str: Any] maps, suitable for decoding into typed values.

enum Driver {
  pgx,
  sqlite,
  mysql,
}

impl Driver {
  fn to_str() Str {
    match self {
      Driver::pgx => "pgx",
      Driver::sqlite => "sqlite",
      Driver::mysql => "mysql",
    }
  }
}

// ─── Driver detection ────────────────────────────────────────────────────

fn Driver::from(url: Str) Driver {
  let u = strings::TrimSpace(url)
  match {
    strings::HasPrefix(u, "postgres://") or strings::HasPrefix(u, "postgresql://") => Driver::pgx,
    strings::Contains(u, "@tcp(") or strings::Contains(u, "@unix(") => Driver::mysql,
    _ => Driver::sqlite,
  }
}

// ─── Named-parameter rewriter ────────────────────────────────────────────
//
// SQL is written with @name placeholders. We rewrite:
//   pgx           -> $1, $2, ...        (positional numbered)
//   sqlite, mysql -> ?                  (positional unnumbered)
// Each occurrence of a @name (including repeats) becomes one placeholder
// and one value is looked up from the args map by that name.

// Named-param regex: @ followed by an identifier.
let param_regex: mut regexp::Regexp = regexp::MustCompile("@([A-Za-z_][A-Za-z0-9_]*)")

fn extract_params(sql: Str) [Str] {
  let params = mut List::new<Str>()
  let matches = param_regex.FindAllStringSubmatch(sql, -1)
  for match_group in matches {
    let name = match_group.at(1).expect("regex has one capture group")
    params.push(name)
  }
  deref params
}

struct PreparedQuery {
  string: Str,
  values: [Any],
}

fn prepare(sql: Str, driver: Driver, params: [Str], args: [Str: Any]) PreparedQuery!Str {
  mut query_str = sql
  let values = mut List::new<Any>()

  for param in params {
    let placeholder = match driver {
      Driver::pgx => "${values.size() + 1}",
      _ => "?",
    }
    // Replace only the first remaining occurrence so duplicate params get
    // distinct positional bindings under pgx.
    query_str = strings::Replace(query_str, "@{param}", placeholder, 1)

    let value = try args.get(param) -> _ { Result::err("Missing parameter: {param}") }
    values.push(value)
  }

  Result::ok(PreparedQuery{string: query_str, values: deref values})
}

// ─── Handles ─────────────────────────────────────────────────────────────

struct Database {
  handle: mut sql::DB,
  driver: Driver,
}

struct Transaction {
  handle: mut sql::Tx,
  driver: Driver,
}

// A Query is bound to either a Database or a Transaction (exactly one of
// db / tx is set). Ard doesn't have sum types across FFI cleanly here, so
// two nullable fields with a runtime invariant is the simplest thing.
struct Query {
  string: Str,
  params: [Str],
  driver: Driver,
  db: (mut sql::DB)?,
  tx: (mut sql::Tx)?,
}

// ─── Open / close / begin ────────────────────────────────────────────────

// Open connects to a database. Driver names correspond to database/sql
// driver registrations from the blank imports above:
//   - "pgx"    -> github.com/jackc/pgx/v5/stdlib
//   - "sqlite" -> modernc.org/sqlite (pure Go)
//   - "mysql"  -> github.com/go-sql-driver/mysql (pure Go)
private fn _open(driver: Driver, url: Str) (mut sql::DB)!Str {
  let db = try sql::Open(driver.to_str(), url)
  try db.Ping() -> err {
    db.Close()
    Result::err(err)
  }

  if driver == Driver::sqlite {
    db.SetMaxOpenConns(1)
  }

  Result::ok(db)
}

fn open(url: Str) Database!Str {
  let driver = Driver::from(url)
  let handle = try _open(driver, url)
  Result::ok(Database{handle: handle, driver: driver})
}

impl Database {
  fn close() Void!Str {
    self.handle.Close()
  }

  fn exec(stmt: Str) Void!Str {
    ffi::ExecDBHandle(self.handle, stmt, mut List::new<Any>())
  }

  fn query(stmt: Str) Query {
    Query{
      string: stmt,
      params: extract_params(stmt),
      driver: self.driver,
      db: Maybe::new(self.handle),
    }
  }

  fn begin() Transaction!Str {
    let tx = try self.handle.Begin()
    Result::ok(Transaction{handle: tx, driver: self.driver})
  }
}

impl Transaction {
  fn exec(stmt: Str) Void!Str {
    ffi::ExecTxHandle(self.handle, stmt, mut List::new<Any>())
  }

  fn query(stmt: Str) Query {
    Query{
      string: stmt,
      params: extract_params(stmt),
      driver: self.driver,
      tx: Maybe::new(self.handle),
    }
  }

  fn commit() Void!Str {
    self.handle.Commit()
  }

  fn rollback() Void!Str {
    self.handle.Rollback()
  }
}

// ─── Query execution ─────────────────────────────────────────────────────

impl Query {
  fn run(args: [Str: Any]) Void!Str {
    let prepared = try prepare(self.string, self.driver, self.params, args)
    match self.db {
      db => ffi::ExecDBHandle(db, prepared.string, mut prepared.values),
      _ => {
        match self.tx {
          tx => ffi::ExecTxHandle(tx, prepared.string, mut prepared.values),
          _ => Result::err("Query bound to neither a Database nor a Transaction"),
        }
      },
    }
  }

  fn all(args: [Str: Any]) [Any]!Str {
    let prepared = try prepare(self.string, self.driver, self.params, args)
    match self.db {
      db => ffi::QueryDBHandle(db, prepared.string, mut prepared.values),
      _ => {
        match self.tx {
          tx => ffi::QueryTxHandle(tx, prepared.string, mut prepared.values),
          _ => Result::err("Query bound to neither a Database nor a Transaction"),
        }
      },
    }
  }

  fn first(args: [Str: Any]) Maybe<Any>!Str {
    let rows = try self.all(args)
    Result::ok(rows.at(0))
  }
}
